# Database
DATABASE_URL=postgres://sunscout:sunscout@127.0.0.1:55432/sunscout

# API
API_PORT=8787
VITE_API_URL=http://127.0.0.1:8787/api

# Auth adapter (optional). Set to switch from the dev header adapter to
# verified JWT auth (e.g. Clerk JWKS). Leave unset for local development.
# SUNSCOUT_JWKS_URL=https://<issuer>/.well-known/jwks.json
# SUNSCOUT_JWT_ISSUER=https://<issuer>

# Payments adapter (optional). Set to enable Stripe test-mode checkout.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Push adapter (optional). Set VAPID keys to enable Web Push delivery.
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...

# Error tracking (optional). Set to send server exceptions to Sentry.
# SENTRY_DSN=https://<key>@<host>/<project>

# Signed QR token secret (set to a strong value in any shared environment).
SUNSCOUT_QR_SECRET=sunscout-dev-qr-secret-change-in-production
